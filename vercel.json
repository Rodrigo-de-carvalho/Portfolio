{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/sobre", "dest": "/sobre.html" },
    { "src": "/projetos", "dest": "/projetos.html" },
    { "src": "/contato", "dest": "/contato.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
